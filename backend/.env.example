# Copy to backend/.env and set local values. backend/.env is gitignored.
# application.yml imports this file for local Spring Boot runs; Docker Compose reads it too.
# Never use these local credentials in a shared or production environment.
DB_NAME=weekly_report_db
DB_URL=jdbc:postgresql://localhost:5432/weekly_report_db
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=

SPRING_PROFILES_ACTIVE=dev
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_DAYS=7
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@weeklyreportgenerator.local

LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
FORGOT_PASSWORD_RATE_LIMIT_PER_MINUTE=5

### 4. Projects
### =====================================================================================

GET {{baseUrl}}/api/projects

###
# @name createProject
POST {{baseUrl}}/api/projects
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "name": "Internal Platform",
  "description": "Internal engineering project"
}

###
GET {{baseUrl}}/api/projects/1

###
PUT {{baseUrl}}/api/projects/1
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "name": "Internal Platform (renamed)",
  "description": "Internal engineering project"
}

###
DELETE {{baseUrl}}/api/projects/1
X-XSRF-TOKEN: {{xsrf}}

### Assign a team member.
POST {{baseUrl}}/api/projects/1/members
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "userId": 4
}


### =====================================================================================
### 5. Weekly Reports
### =====================================================================================

### Create a draft.
# @name createReport
POST {{baseUrl}}/api/reports
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "projectId": 1,
  "weekStartDate": "2026-09-21",
  "weekEndDate": "2026-09-27",
  "summary": "Sample report created from the .http collection",
  "tasks": [
    {
      "taskName": "Sample task",
      "status": "COMPLETED",
      "priority": "HIGH",
      "plannedPercentage": 100,
      "actualPercentage": 100,
      "hoursPlanned": 8,
      "hoursSpent": 8
    }
  ]
}

### My reports.
GET {{baseUrl}}/api/reports/my?page=0&size=10

### Single report.
GET {{baseUrl}}/api/reports/1

### Update (DRAFT or NEEDS_CORRECTION only).
PUT {{baseUrl}}/api/reports/1
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "projectId": 1,
  "weekStartDate": "2026-09-21",
  "weekEndDate": "2026-09-27",
  "summary": "Updated summary",
  "tasks": [
    {
      "taskName": "Sample task",
      "status": "COMPLETED",
      "priority": "HIGH",
      "plannedPercentage": 100,
      "actualPercentage": 100,
      "hoursPlanned": 8,
      "hoursSpent": 8
    }
  ]
}

### Submit for review.
POST {{baseUrl}}/api/reports/1/submit
X-XSRF-TOKEN: {{xsrf}}

### Delete a draft.
DELETE {{baseUrl}}/api/reports/1
X-XSRF-TOKEN: {{xsrf}}

### Version/review history.
GET {{baseUrl}}/api/reports/1/history


